VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SITE_URL=https://letsfindpeople.com

# Keep Stripe, GIPHY, Resend, and SUPABASE_SERVICE_ROLE_KEY secrets out of
# Vite/frontend env files. Set Edge Function secrets with `supabase secrets set`.
#
# Required GIPHY Edge Function secret:
#   supabase secrets set GIPHY_API_KEY=your-giphy-api-key
#   Existing VITE_GIPHY_API_KEY Supabase secrets are also supported by giphy-search.
